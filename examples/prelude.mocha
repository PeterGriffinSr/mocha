(define list (lambda (& xs) xs))
(define identity (lambda (x) x))
(define null? (lambda (x) (eq? x '())))
(define not null?)
(define = eq?)

(define car (lambda (xs) (data-ref xs 0)))
(define cdr (lambda (xs) (data-ref xs 1)))

(define caar (lambda (x) (car (car x))))
(define cadr (lambda (x) (car (cdr x))))
(define cdar (lambda (x) (cdr (car x))))
(define cddr (lambda (x) (cdr (cdr x))))
(define caddr (lambda (x) (car (cddr x))))

(defmacro and (& xs)
  (if (null? xs)
      't
      (if (null? (cdr xs))
          (car xs)
          (list 'if (car xs) (cons 'and (cdr xs)) '()))))

(defmacro or (& xs)
  (if (null? xs)
      '()
      (list (list 'lambda
                  (list '%or-tmp)
                  (list 'if '%or-tmp '%or-tmp (cons 'or (cdr xs))))
            (car xs))))

(defmacro cond (& clauses)
  (if (null? clauses)
      '()
      (list 'if
            (caar clauses)
            (cadr (car clauses))
            (cons 'cond (cdr clauses)))))

(define > (lambda (a b) (< b a)))
(define <= (lambda (a b) (not (< b a))))
(define >= (lambda (a b) (not (< a b))))

(define abs (lambda (x) (if (< x 0) (- 0 x) x)))
(define min (lambda (a b) (if (< a b) a b)))
(define max (lambda (a b) (if (> a b) a b)))

(define map
  (lambda (f xs)
    (if (null? xs)
        '()
        (cons (f (car xs)) (map f (cdr xs))))))

(defmacro let (bindings & body)
  (cons (list 'lambda (map car bindings) (car body))
        (map cadr bindings)))

(define fold-left
  (lambda (f acc xs)
    (if (null? xs)
        acc
        (fold-left f (f acc (car xs)) (cdr xs)))))

(define fold-right
  (lambda (f acc xs)
    (if (null? xs)
        acc
        (f (car xs) (fold-right f acc (cdr xs))))))

(define length
  (lambda (xs)
    (if (null? xs) 0 (+ 1 (length (cdr xs))))))

(define append
  (lambda (a b)
    (if (null? a) b (cons (car a) (append (cdr a) b)))))

(define reverse
  (lambda (xs)
    (fold-left (lambda (acc x) (cons x acc)) '() xs)))

(define filter
  (lambda (pred xs)
    (cond ((null? xs) '())
          ((pred (car xs)) (cons (car xs) (filter pred (cdr xs))))
          (else (filter pred (cdr xs))))))

(define nth
  (lambda (n xs)
    (if (= n 0) (car xs) (nth (- n 1) (cdr xs)))))

(define range
  (lambda (lo hi)
    (if (>= lo hi) '() (cons lo (range (+ lo 1) hi)))))

(define member
  (lambda (x xs)
    (cond ((null? xs) '())
          ((eq? x (car xs)) xs)
          (else (member x (cdr xs))))))

(define assoc
  (lambda (k alist)
    (cond ((null? alist) '())
          ((eq? k (caar alist)) (car alist))
          (else (assoc k (cdr alist))))))

(define any
  (lambda (pred xs)
    (cond ((null? xs) '())
          ((pred (car xs)) 't)
          (else (any pred (cdr xs))))))

(define all
  (lambda (pred xs)
    (cond ((null? xs) 't)
          ((pred (car xs)) (all pred (cdr xs)))
          (else '()))))

(define compose
  (lambda (f g) (lambda (x) (f (g x)))))

(define sum (lambda (xs) (fold-left + 0 xs)))
(define product (lambda (xs) (fold-left * 1 xs)))